# FreebieMe Environment Variables
# Copy this to .env and fill in values

# Node environment
NODE_ENV=development

# Optional: Slack/Discord webhook for scraper failure alerts
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...

# Optional: Override OSM Overpass API endpoint
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: Scraper delay in milliseconds (default: 2000)
# SCRAPER_DELAY_MS=2000
